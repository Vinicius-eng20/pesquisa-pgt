<header class="topbar">
  <a class="brand" href="/">Shopping Online</a>

  <nav class="nav">
    <a href="/">Produtos</a>

    <% if (user) { %>
      <a href="/cart">Carrinho (<%= cartCount %>)</a>
      <a href="/orders">Meus pedidos</a>

      <% if (user.role === 'admin') { %>
        <a href="/admin/products">Admin produtos</a>
        <a href="/admin/orders">Admin pedidos</a>
      <% } %>

      <span class="hello">Olá, <%= user.name %></span>

      <form action="/logout" method="post" class="inline">
        <button type="submit" class="link-button">Sair</button>
      </form>
    <% } else { %>
      <a href="/login">Entrar</a>
      <a href="/register">Criar conta</a>
    <% } %>
  </nav>
</header>
