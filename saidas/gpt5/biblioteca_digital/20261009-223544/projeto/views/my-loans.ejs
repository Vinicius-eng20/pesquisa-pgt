<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meus empréstimos - Biblioteca Digital</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <%- include('partials/flash') %>

    <section class="card">
      <h1>Meus empréstimos</h1>
      <p class="muted">Veja seus itens emprestados e devolva quando terminar.</p>
    </section>

    <section class="card table-wrap">
      <% if (loans.length === 0) { %>
        <p>Você ainda não pegou nenhum item emprestado.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Empréstimo</th>
              <th>Prazo</th>
              <th>Status</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% loans.forEach(loan => { %>
              <tr>
                <td>
                  <strong><%= loan.title %></strong><br>
                  <span class="muted"><%= loan.author || '' %></span>
                </td>
                <td><%= loan.borrowed_at %></td>
                <td><%= loan.due_at %></td>
                <td>
                  <% if (loan.returned_at) { %>
                    <span class="badge success">Devolvido</span><br>
                    <span class="muted"><%= loan.returned_at %></span>
                  <% } else if (loan.overdue) { %>
                    <span class="badge danger">Em atraso</span>
                  <% } else { %>
                    <span class="badge warning">Emprestado</span>
                  <% } %>
                </td>
                <td>
                  <% if (!loan.returned_at) { %>
                    <form action="/loans/<%= loan.id %>/return" method="post">
                      <button type="submit">Devolver</button>
                    </form>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
</body>
</html>
