<%- include('partials/head', { title: 'Gerenciar cardápio' }) %>
<%- include('partials/header') %>

<section class="page-title">
  <h1>Gerenciar cardápio</h1>
  <p>Cadastre, edite ou remova pratos do restaurante.</p>
</section>

<div class="manager-layout">
  <section class="card">
    <h2><%= editing ? 'Editar prato' : 'Cadastrar prato' %></h2>

    <form action="<%= editing ? '/gerente/cardapio/' + editing.id + '/editar' : '/gerente/cardapio' %>" method="POST">
      <label>
        Nome do prato
        <input type="text" name="name" required value="<%= editing ? editing.name : '' %>">
      </label>

      <label>
        Descrição
        <textarea name="description" rows="4"><%= editing ? editing.description : '' %></textarea>
      </label>

      <label>
        Preço
        <input type="number" name="price" required min="0.01" step="0.01" value="<%= editing ? editing.price : '' %>">
      </label>

      <label class="checkbox">
        <input type="checkbox" name="available" <%= !editing || editing.available ? 'checked' : '' %>>
        Disponível para clientes
      </label>

      <button class="button full" type="submit"><%= editing ? 'Salvar alterações' : 'Cadastrar prato' %></button>

      <% if (editing) { %>
        <a class="button secondary full" href="/gerente/cardapio">Cancelar edição</a>
      <% } %>
    </form>
  </section>

  <section class="card">
    <h2>Pratos cadastrados</h2>

    <% if (dishes.length === 0) { %>
      <p>Nenhum prato cadastrado.</p>
    <% } %>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Prato</th>
            <th>Preço</th>
            <th>Situação</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% dishes.forEach(dish => { %>
            <tr>
              <td>
                <strong><%= dish.name %></strong><br>
                <span class="muted"><%= dish.description || '' %></span>
              </td>
              <td><%= formatMoney(dish.price) %></td>
              <td><%= dish.available ? 'Disponível' : 'Indisponível' %></td>
              <td class="actions">
                <a class="button small secondary" href="/gerente/cardapio/<%= dish.id %>/editar">Editar</a>
                <form action="/gerente/cardapio/<%= dish.id %>/remover" method="POST" onsubmit="return confirm('Remover este prato?')">
                  <button class="button small danger" type="submit">Remover</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
