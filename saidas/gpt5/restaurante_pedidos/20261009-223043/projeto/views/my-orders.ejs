<%- include('partials/head', { title: 'Meus pedidos' }) %>
<%- include('partials/header') %>

<section class="page-title">
  <h1>Meus pedidos</h1>
  <p>Acompanhe aqui todos os pedidos feitos pela sua conta.</p>
</section>

<% if (orders.length === 0) { %>
  <div class="card center">
    <p>Você ainda não fez nenhum pedido.</p>
    <a class="button" href="/">Ver cardápio</a>
  </div>
<% } %>

<div class="orders">
  <% orders.forEach(order => { %>
    <article class="card order">
      <div class="order-head">
        <div>
          <h2>Pedido #<%= order.id %></h2>
          <p class="muted">Criado em <%= order.created_at %></p>
        </div>
        <span class="status"><%= order.status %></span>
      </div>

      <ul class="items">
        <% itemsByOrder[order.id].forEach(item => { %>
          <li>
            <span><%= item.quantity %>x <%= item.name || 'Prato removido' %></span>
            <strong><%= formatMoney(item.quantity * item.unit_price) %></strong>
          </li>
        <% }) %>
      </ul>

      <% if (order.notes) { %>
        <p><strong>Observações:</strong> <%= order.notes %></p>
      <% } %>

      <div class="total">
        Total: <%= formatMoney(order.total) %>
      </div>
    </article>
  <% }) %>
</div>

<%- include('partials/footer') %>
