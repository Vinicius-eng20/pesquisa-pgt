<%- include('partials/header') %>

<div class="auth-card">
  <h1>Criar conta de aluno</h1>

  <form method="post" action="/register" class="form">
    <label>
      Nome
      <input type="text" name="name" value="<%= values.name || '' %>" required autocomplete="name">
    </label>

    <label>
      Email
      <input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
    </label>

    <label>
      Senha
      <input type="password" name="password" required autocomplete="new-password" minlength="6">
    </label>

    <label>
      Confirmar senha
      <input type="password" name="passwordConfirm" required autocomplete="new-password" minlength="6">
    </label>

    <button class="button full" type="submit">Criar conta</button>
  </form>

  <p class="muted center">
    Já tem conta?
    <a href="/login">Entrar</a>
  </p>
</div>

<%- include('partials/footer') %>
