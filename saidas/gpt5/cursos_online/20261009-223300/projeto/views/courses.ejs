<%- include('partials/header') %>

<div class="page-title">
  <div>
    <h1>Cursos disponíveis</h1>
    <p>Escolha um curso e faça sua matrícula.</p>
  </div>
</div>

<% if (courses.length === 0) { %>
  <div class="empty">Nenhum curso disponível no momento.</div>
<% } else { %>
  <section class="grid">
    <% courses.forEach(course => { %>
      <article class="card course-card">
        <div class="card-head">
          <h2><%= course.title %></h2>
          <% if (course.enrollment_status === 'active') { %>
            <span class="badge success">Matriculado</span>
          <% } else if (course.enrollment_status === 'cancelled') { %>
            <span class="badge warning">Cancelada</span>
          <% } %>
        </div>

        <p><%= course.description %></p>

        <dl class="details">
          <div>
            <dt>Carga horária</dt>
            <dd><%= course.workload %></dd>
          </div>
          <div>
            <dt>Professor</dt>
            <dd><%= course.teacher %></dd>
          </div>
        </dl>

        <% if (course.enrollment_status === 'active') { %>
          <a class="button secondary full" href="/my-enrollments">Ver matrícula</a>
        <% } else { %>
          <form action="/courses/<%= course.id %>/enroll" method="post">
            <button class="button full" type="submit">
              <%= course.enrollment_status === 'cancelled' ? 'Matricular novamente' : 'Matricular-me' %>
            </button>
          </form>
        <% } %>
      </article>
    <% }) %>
  </section>
<% } %>

<%- include('partials/footer') %>
