<%- include('../partials/header') %>

<div class="page-title">
  <div>
    <h1>Todas as matrículas</h1>
    <p>Veja e gerencie as matrículas de todos os alunos.</p>
  </div>
</div>

<div class="filter-bar">
  <a class="button small <%= status === 'all' ? '' : 'secondary' %>" href="/admin/enrollments">Todas</a>
  <a class="button small <%= status === 'active' ? '' : 'secondary' %>" href="/admin/enrollments?status=active">Ativas</a>
  <a class="button small <%= status === 'cancelled' ? '' : 'secondary' %>" href="/admin/enrollments?status=cancelled">Canceladas</a>
</div>

<% if (enrollments.length === 0) { %>
  <div class="empty">Nenhuma matrícula encontrada.</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Aluno</th>
          <th>Curso</th>
          <th>Status</th>
          <th>Data da matrícula</th>
          <th>Cancelada em</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% enrollments.forEach(enrollment => { %>
          <tr>
            <td>
              <strong><%= enrollment.student_name %></strong><br>
              <span class="muted"><%= enrollment.student_email %></span>
            </td>
            <td>
              <strong><%= enrollment.course_title %></strong><br>
              <span class="muted"><%= enrollment.course_workload %></span>
            </td>
            <td>
              <% if (enrollment.status === 'active') { %>
                <span class="badge success">Ativa</span>
              <% } else { %>
                <span class="badge danger">Cancelada</span>
              <% } %>
            </td>
            <td><%= enrollment.created_at %></td>
            <td><%= enrollment.cancelled_at || '-' %></td>
            <td>
              <% if (enrollment.status === 'active') { %>
                <form action="/admin/enrollments/<%= enrollment.id %>/cancel" method="post" data-confirm="Cancelar esta matrícula?">
                  <button class="button small danger" type="submit">Cancelar</button>
                </form>
              <% } else { %>
                <span class="muted">Sem ação</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
