<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entrar - Equipe Tarefas</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="login-page">
  <main class="login-card">
    <h1>Equipe Tarefas</h1>
    <p class="muted">Entre com sua conta para acessar suas tarefas.</p>

    <%- include('partials/messages') %>

    <form action="/login" method="post" class="form">
      <label>
        E-mail
        <input type="email" name="email" required autofocus placeholder="seu@email.com">
      </label>

      <label>
        Senha
        <input type="password" name="password" required placeholder="Sua senha">
      </label>

      <button type="submit" class="button full">Entrar</button>
    </form>

    <div class="default-login">
      <strong>Primeiro acesso:</strong><br>
      gerente@equipe.com<br>
      senha: 123456
    </div>
  </main>
</body>
</html>
