<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minha conta - Equipe Tarefas</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container narrow">
    <%- include('partials/messages') %>

    <section class="card">
      <h1>Minha conta</h1>

      <form action="/minha-conta" method="post" class="form">
        <label>
          Nome
          <input type="text" name="name" required value="<%= currentUser.name %>">
        </label>

        <label>
          E-mail
          <input type="email" value="<%= currentUser.email %>" disabled>
        </label>

        <label>
          Nova senha
          <input type="password" name="password" minlength="6" placeholder="Deixe em branco para manter a senha atual">
        </label>

        <button type="submit" class="button">Salvar</button>
      </form>
    </section>
  </main>
</body>
</html>
