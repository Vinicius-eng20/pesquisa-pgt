<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tarefas - Equipe Tarefas</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <%- include('partials/messages') %>

    <section class="page-title">
      <div>
        <h1>Tarefas</h1>
        <p>
          Olá, <strong><%= currentUser.name %></strong>.
          <% if (currentUser.role === 'manager') { %>
            Você está usando uma conta de gerente.
          <% } else { %>
            Estas são as suas tarefas.
          <% } %>
        </p>
      </div>
    </section>

    <section class="card">
      <h2>Criar nova tarefa</h2>

      <form action="/tarefas" method="post" class="grid-form">
        <label>
          Título
          <input type="text" name="title" required placeholder="Ex: Preparar relatório">
        </label>

        <% if (currentUser.role === 'manager') { %>
          <label>
            Responsável
            <select name="assigned_to" required>
              <% members.forEach(member => { %>
                <option value="<%= member.id %>"><%= member.name %> - <%= member.role === 'manager' ? 'Gerente' : 'Membro' %></option>
              <% }) %>
            </select>
          </label>
        <% } %>

        <label>
          Prazo
          <input type="date" name="due_date">
        </label>

        <label class="full-row">
          Descrição
          <textarea name="description" rows="3" placeholder="Detalhes da tarefa"></textarea>
        </label>

        <div class="full-row">
          <button type="submit" class="button">Criar tarefa</button>
        </div>
      </form>
    </section>

    <section class="tasks">
      <% if (tasks.length === 0) { %>
        <div class="empty">
          Nenhuma tarefa encontrada.
        </div>
      <% } %>

      <% tasks.forEach(task => { %>
        <article class="task-card status-<%= task.status.replace(' ', '-') %>">
          <div class="task-header">
            <div>
              <h2><%= task.title %></h2>
              <span class="badge"><%= task.status %></span>
            </div>

            <% if (currentUser.role === 'manager') { %>
              <div class="actions">
                <a class="small-button" href="/tarefas/<%= task.id %>/editar">Editar</a>
                <form action="/tarefas/<%= task.id %>/remover" method="post" onsubmit="return confirm('Remover esta tarefa?')">
                  <button class="small-button danger" type="submit">Remover</button>
                </form>
              </div>
            <% } %>
          </div>

          <% if (task.description) { %>
            <p class="description"><%= task.description %></p>
          <% } %>

          <div class="task-meta">
            <span><strong>Responsável:</strong> <%= task.assigned_name %></span>
            <span><strong>Criada por:</strong> <%= task.creator_name %></span>
            <% if (task.due_date) { %>
              <span><strong>Prazo:</strong> <%= task.due_date %></span>
            <% } %>
          </div>

          <form action="/tarefas/<%= task.id %>/status" method="post" class="status-form">
            <label>
              Alterar status
              <select name="status">
                <option value="pendente" <%= task.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                <option value="em andamento" <%= task.status === 'em andamento' ? 'selected' : '' %>>Em andamento</option>
                <option value="concluída" <%= task.status === 'concluída' ? 'selected' : '' %>>Concluída</option>
              </select>
            </label>
            <button type="submit" class="button secondary">Salvar status</button>
          </form>
        </article>
      <% }) %>
    </section>
  </main>
</body>
</html>
