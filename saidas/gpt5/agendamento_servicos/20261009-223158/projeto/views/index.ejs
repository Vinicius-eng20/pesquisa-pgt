<%- include('partials/header') %>

<section class="hero">
  <div>
    <h1>Agende serviços pela internet</h1>
    <p>Veja os serviços disponíveis, escolha um horário livre e acompanhe seus agendamentos pela sua conta.</p>

    <% if (!user) { %>
      <div class="actions">
        <a class="button" href="/register">Criar conta</a>
        <a class="button secondary" href="/login">Entrar</a>
      </div>
    <% } else if (user.role === 'admin') { %>
      <a class="button" href="/admin">Ir para o painel</a>
    <% } else { %>
      <a class="button" href="/cliente">Ver serviços</a>
    <% } %>
  </div>
</section>

<section class="card">
  <h2>Serviços disponíveis</h2>

  <% if (services.length === 0) { %>
    <p>Nenhum serviço cadastrado no momento.</p>
  <% } %>

  <div class="grid">
    <% services.forEach(service => { %>
      <div class="service-card">
        <h3><%= service.name %></h3>
        <p><%= service.description || 'Sem descrição.' %></p>
        <p><strong>Duração:</strong> <%= service.duration_minutes %> minutos</p>
        <p><strong>Preço:</strong> R$ <%= Number(service.price).toFixed(2).replace('.', ',') %></p>

        <% if (user && user.role === 'client') { %>
          <a class="button small" href="/cliente/servico/<%= service.id %>">Escolher horário</a>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
