<%- include('partials/header', { title, user, flash }) %>

<section class="hero">
  <h1>Todas as inscrições</h1>
  <p>Veja participantes inscritos e confirme presença.</p>
</section>

<div class="card">
  <% if (registrations.length === 0) { %>
    <div class="empty">Ainda não há inscrições.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Participante</th>
            <th>Evento</th>
            <th>Data</th>
            <th>Status</th>
            <th>Presença</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% registrations.forEach(reg => { %>
            <tr>
              <td>
                <strong><%= reg.user_name %></strong><br>
                <span class="meta"><%= reg.user_email %></span>
              </td>
              <td>
                <%= reg.event_title %>
                <% if (reg.event_status === 'cancelado') { %>
                  <br><span class="badge danger">Evento cancelado</span>
                <% } %>
              </td>
              <td><%= new Date(reg.event_date).toLocaleString('pt-BR') %></td>
              <td>
                <% if (reg.status === 'cancelada') { %>
                  <span class="badge danger">Cancelada</span>
                <% } else if (reg.status === 'confirmada') { %>
                  <span class="badge success">Confirmada</span>
                <% } else { %>
                  <span class="badge">Inscrita</span>
                <% } %>
              </td>
              <td>
                <% if (reg.attendance_confirmed) { %>
                  <span class="badge success">Presença confirmada</span>
                <% } else { %>
                  <span class="badge warning">Pendente</span>
                <% } %>
              </td>
              <td>
                <% if (reg.status !== 'cancelada') { %>
                  <% if (reg.attendance_confirmed) { %>
                    <form method="post" action="/organizer/registrations/<%= reg.id %>/unconfirm">
                      <button class="secondary" type="submit">Remover confirmação</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/organizer/registrations/<%= reg.id %>/confirm">
                      <button type="submit">Confirmar presença</button>
                    </form>
                  <% } %>
                <% } else { %>
                  -
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
