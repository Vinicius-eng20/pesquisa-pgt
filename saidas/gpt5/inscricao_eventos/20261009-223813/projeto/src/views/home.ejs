<%- include('partials/header', { title, user, flash }) %>

<section class="hero">
  <h1>Eventos disponíveis</h1>
  <p>Veja os próximos eventos e faça sua inscrição com sua conta.</p>
</section>

<% if (events.length === 0) { %>
  <div class="card empty">
    Nenhum evento disponível no momento.
  </div>
<% } else { %>
  <div class="grid">
    <% events.forEach(event => { %>
      <article class="card event-card">
        <div>
          <h2><%= event.title %></h2>
          <p class="meta">Data: <%= new Date(event.event_date).toLocaleString('pt-BR') %></p>
          <p class="meta">Local: <%= event.location %></p>
          <p><%= event.description.length > 130 ? event.description.slice(0, 130) + '...' : event.description %></p>
          <p class="meta">
            Inscritos: <%= event.active_registrations %>
            <% if (event.capacity) { %>
              / <%= event.capacity %>
            <% } %>
          </p>
        </div>
        <div class="actions">
          <a class="btn" href="/events/<%= event.id %>">Ver detalhes</a>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
