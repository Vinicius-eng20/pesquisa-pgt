<%- include('partials/header') %>

<section class="hero">
  <div>
    <h1>Contrate e ofereça serviços freelance</h1>
    <p>Publique seus serviços, encontre profissionais e acompanhe seus contratos em um só lugar.</p>

    <% if (user) { %>
      <a class="button" href="/services/new">Publicar serviço</a>
      <a class="button secondary" href="/dashboard">Minha área</a>
    <% } else { %>
      <a class="button" href="/register">Começar agora</a>
      <a class="button secondary" href="/login">Entrar</a>
    <% } %>
  </div>
</section>

<h2>Serviços disponíveis</h2>

<% if (services.length === 0) { %>
  <div class="empty">Ainda não há serviços aprovados disponíveis.</div>
<% } %>

<div class="grid">
  <% services.forEach(service => { %>
    <article class="card">
      <h3><%= service.title %></h3>
      <p class="muted">Por <%= service.owner_name %></p>
      <p><%= service.description.length > 160 ? service.description.substring(0, 160) + '...' : service.description %></p>
      <strong>R$ <%= Number(service.price).toFixed(2).replace('.', ',') %></strong>
      <a class="button full" href="/services/<%= service.id %>">Ver serviço</a>
    </article>
  <% }) %>
</div>

<%- include('partials/footer') %>
