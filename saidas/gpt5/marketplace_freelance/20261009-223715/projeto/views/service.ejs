<%- include('partials/header') %>

<article class="service-detail">
  <h1><%= service.title %></h1>
  <p class="muted">Publicado por <%= service.owner_name %></p>

  <div class="price">R$ <%= Number(service.price).toFixed(2).replace('.', ',') %></div>

  <p class="description"><%= service.description %></p>

  <% if (user) { %>
    <% if (user.id === service.user_id) { %>
      <div class="alert">Este serviço é seu.</div>
    <% } else { %>
      <form action="/services/<%= service.id %>/hire" method="POST">
        <button class="button" type="submit">Contratar serviço</button>
      </form>
    <% } %>
  <% } else { %>
    <a class="button" href="/login">Entrar para contratar</a>
  <% } %>
</article>

<%- include('partials/footer') %>
