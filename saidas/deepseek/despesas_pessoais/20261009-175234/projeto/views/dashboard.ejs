<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meu Painel - Controle de Despesas</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header>
  <div class="header-inner">
    <h1>💰 Controle de Despesas</h1>
    <nav>
      <span>Olá, <%= user.nome %></span>
      <% if (user.is_admin) { %><a href="/admin">Painel Admin</a><% } %>
      <a href="/logout">Sair</a>
    </nav>
  </div>
</header>

<main>
  <section class="card">
    <h2>Registrar despesa</h2>
    <form method="POST" action="/despesas" class="form-despesa">
      <div>
        <label>Valor (R$)</label>
        <input type="text" name="valor" placeholder="0,00" required>
      </div>
      <div>
        <label>Data</label>
        <input type="date" name="data" required value="<%= new Date().toISOString().slice(0,10) %>">
      </div>
      <div>
        <label>Categoria</label>
        <select name="categoria_id" required>
          <option value="">Selecione</option>
          <% categorias.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.nome %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Descrição</label>
        <input type="text" name="descricao" placeholder="Opcional">
      </div>
      <button type="submit">Adicionar</button>
    </form>
  </section>

  <section class="card">
    <div class="mes-header">
      <h2>Resumo do mês</h2>
      <form method="GET" action="/dashboard" class="form-mes">
        <input type="month" name="mes" value="<%= mes %>" onchange="this.form.submit()">
      </form>
    </div>
    <div class="total-box">
      <span>Total gasto em <%= mes %>:</span>
      <strong>R$ <%= total.toFixed(2).replace('.', ',') %></strong>
    </div>

    <% const catKeys = Object.keys(porCategoria); %>
    <% if (catKeys.length > 0) { %>
      <h3>Por categoria</h3>
      <ul class="categorias-resumo">
        <% catKeys.forEach(k => { %>
          <li><span><%= k %></span><strong>R$ <%= porCategoria[k].toFixed(2).replace('.', ',') %></strong></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <h2>Despesas do mês</h2>
    <% if (despesas.length === 0) { %>
      <p class="vazio">Nenhuma despesa registrada neste mês.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Data</th><th>Categoria</th><th>Descrição</th><th>Valor</th><th></th></tr>
        </thead>
        <tbody>
          <% despesas.forEach(d => { %>
            <tr>
              <td><%= d.data.split('-').reverse().join('/') %></td>
              <td><%= d.categoria %></td>
              <td><%= d.descricao || '-' %></td>
              <td>R$ <%= d.valor.toFixed(2).replace('.', ',') %></td>
              <td>
                <form method="POST" action="/despesas/<%= d.id %>/excluir" onsubmit="return confirm('Excluir?')">
                  <button class="btn-excluir">×</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>
</body>
</html>
