<%- include('layout-header') %>
<h1>Painel do Administrador</h1>

<div class="admin-section">
  <h2>Cadastrar Novo Curso</h2>
  <form method="POST" action="/admin/courses">
    <input type="text" name="title" placeholder="Título do curso" required>
    <textarea name="description" placeholder="Descrição" required rows="2"></textarea>
    <input type="text" name="instructor" placeholder="Instrutor" required>
    <input type="text" name="duration" placeholder="Duração (ex: 20 horas)" required>
    <button class="btn" type="submit">Cadastrar Curso</button>
  </form>
</div>

<div class="admin-section">
  <h2>Cursos Cadastrados</h2>
  <% courses.forEach(c => { %>
    <div style="border:1px solid #eee; border-radius:8px; padding:12px; margin-bottom:12px;">
      <form method="POST" action="/admin/courses/<%= c.id %>/edit">
        <input type="text" name="title" value="<%= c.title %>" required>
        <textarea name="description" required rows="2"><%= c.description %></textarea>
        <input type="text" name="instructor" value="<%= c.instructor %>" required>
        <input type="text" name="duration" value="<%= c.duration %>" required>
        <button class="btn btn-secondary" type="submit">Salvar</button>
      </form>
      <form method="POST" action="/admin/courses/<%= c.id %>/delete" onsubmit="return confirm('Remover este curso? As matrículas serão canceladas.');" style="margin-top:8px;">
        <button class="btn btn-danger" type="submit">Remover Curso</button>
      </form>
    </div>
  <% }); %>
  <% if (courses.length === 0) { %><p>Nenhum curso cadastrado.</p><% } %>
</div>

<div class="admin-section">
  <h2>Todas as Matrículas</h2>
  <% if (enrollments.length > 0) { %>
    <table>
      <thead>
        <tr><th>Aluno</th><th>E-mail</th><th>Curso</th><th>Data</th><th>Ação</th></tr>
      </thead>
      <tbody>
        <% enrollments.forEach(e => { %>
          <tr>
            <td><%= e.user_name %></td>
            <td><%= e.user_email %></td>
            <td><%= e.course_title %></td>
            <td><%= new Date(e.created_at).toLocaleDateString('pt-BR') %></td>
            <td>
              <form method="POST" action="/admin/enrollments/<%= e.id %>/cancel" onsubmit="return confirm('Cancelar esta matrícula?');">
                <button class="btn btn-danger" type="submit" style="padding:5px 10px; font-size:0.85em;">Cancelar</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>Nenhuma matrícula registrada.</p>
  <% } %>
</div>
<%- include('layout-footer') %>
