<%- include('partials/header', { title, user, flash }) %>

<article class="card">
  <h1><%= event.title %></h1>

  <% if (event.status === 'cancelado') { %>
    <p><span class="badge danger">Evento cancelado</span></p>
  <% } else { %>
    <p><span class="badge success">Evento ativo</span></p>
  <% } %>

  <p class="meta">Data: <%= new Date(event.event_date).toLocaleString('pt-BR') %></p>
  <p class="meta">Local: <%= event.location %></p>
  <p class="meta">
    Inscritos: <%= event.active_registrations %>
    <% if (event.capacity) { %>
      / <%= event.capacity %>
    <% } %>
  </p>

  <p><%= event.description %></p>

  <div class="actions">
    <% if (!user) { %>
      <a class="btn" href="/login">Entrar para se inscrever</a>
      <a class="btn secondary" href="/register">Criar conta</a>
    <% } else if (user.role === 'participant') { %>
      <% if (registration && registration.status !== 'cancelada') { %>
        <span class="badge success">Você já está inscrito</span>
        <a class="btn secondary" href="/my-registrations">Ver minhas inscrições</a>
      <% } else if (event.status === 'ativo') { %>
        <form method="post" action="/events/<%= event.id %>/register">
          <button type="submit">Inscrever-se</button>
        </form>
      <% } %>
    <% } else { %>
      <a class="btn" href="/organizer/events/<%= event.id %>/edit">Editar evento</a>
    <% } %>
  </div>
</article>

<%- include('partials/footer') %>
