<%- include('partials/header', { title, user, flash }) %>

<div class="card form">
  <h1><%= title %></h1>

  <form method="post" action="<%= action %>">
    <label for="title">Nome do evento</label>
    <input id="title" name="title" required value="<%= event ? event.title : '' %>">

    <label for="description">Descrição</label>
    <textarea id="description" name="description" required><%= event ? event.description : '' %></textarea>

    <label for="location">Local</label>
    <input id="location" name="location" required value="<%= event ? event.location : '' %>">

    <label for="event_date">Data e hora</label>
    <input id="event_date" name="event_date" type="datetime-local" required value="<%= event ? event.event_date : '' %>">

    <label for="capacity">Quantidade de vagas</label>
    <input id="capacity" name="capacity" type="number" min="0" placeholder="Deixe 0 ou vazio para ilimitado" value="<%= event && event.capacity ? event.capacity : '' %>">

    <% if (event) { %>
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="ativo" <%= event.status === 'ativo' ? 'selected' : '' %>>Ativo</option>
        <option value="cancelado" <%= event.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
      </select>
    <% } %>

    <p></p>
    <div class="actions">
      <button type="submit">Salvar</button>
      <a class="btn secondary" href="/organizer">Voltar</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
