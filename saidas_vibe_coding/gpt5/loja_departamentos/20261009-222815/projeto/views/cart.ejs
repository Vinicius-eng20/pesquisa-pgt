<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carrinho</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <section class="card">
      <h1>Carrinho</h1>

      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>

      <% if (items.length === 0) { %>
        <p>Seu carrinho está vazio.</p>
        <a class="button" href="/">Ver produtos</a>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Produto</th>
                <th>Preço</th>
                <th>Quantidade</th>
                <th>Subtotal</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
                <tr>
                  <td>
                    <div class="cart-product">
                      <img src="<%= item.image_url || '/img/no-image.svg' %>" alt="<%= item.name %>">
                      <span><%= item.name %></span>
                    </div>
                  </td>
                  <td><%= money(item.price) %></td>
                  <td>
                    <form action="/cart/update/<%= item.id %>" method="post" class="qty-form">
                      <input type="number" name="quantity" min="1" max="<%= item.stock %>" value="<%= item.quantity %>">
                      <button type="submit">Atualizar</button>
                    </form>
                  </td>
                  <td><%= money(item.subtotal) %></td>
                  <td>
                    <form action="/cart/remove/<%= item.id %>" method="post">
                      <button type="submit" class="danger">Remover</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="checkout">
          <h2>Total: <%= money(total) %></h2>
          <form action="/checkout" method="post">
            <button type="submit">Finalizar pedido</button>
          </form>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
