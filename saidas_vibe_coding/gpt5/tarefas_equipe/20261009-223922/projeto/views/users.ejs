<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários - Equipe Tarefas</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <%- include('partials/messages') %>

    <section class="page-title">
      <div>
        <h1>Usuários da equipe</h1>
        <p>Crie as contas das pessoas que usarão o sistema.</p>
      </div>
    </section>

    <section class="card">
      <h2>Criar usuário</h2>

      <form action="/usuarios" method="post" class="grid-form">
        <label>
          Nome
          <input type="text" name="name" required placeholder="Nome da pessoa">
        </label>

        <label>
          E-mail
          <input type="email" name="email" required placeholder="pessoa@email.com">
        </label>

        <label>
          Senha inicial
          <input type="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres">
        </label>

        <label>
          Tipo
          <select name="role" required>
            <option value="member">Membro</option>
            <option value="manager">Gerente</option>
          </select>
        </label>

        <div class="full-row">
          <button type="submit" class="button">Criar usuário</button>
        </div>
      </form>
    </section>

    <section class="card">
      <h2>Usuários cadastrados</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Tipo</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td><%= user.role === 'manager' ? 'Gerente' : 'Membro' %></td>
                <td>
                  <% if (user.id !== currentUser.id) { %>
                    <form action="/usuarios/<%= user.id %>/remover" method="post" onsubmit="return confirm('Remover este usuário? As tarefas dele também serão removidas.')">
                      <button type="submit" class="small-button danger">Remover</button>
                    </form>
                  <% } else { %>
                    Você
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
