<%- include('../partials/header') %>

<section class="card">
  <h1>Minha área</h1>
  <p>Olá, <strong><%= user.name %></strong>. Aqui você pode marcar, ver e cancelar seus horários.</p>
</section>

<section class="card">
  <h2>Escolher serviço</h2>

  <% if (services.length === 0) { %>
    <p>Nenhum serviço disponível no momento.</p>
  <% } %>

  <div class="grid">
    <% services.forEach(service => { %>
      <div class="service-card">
        <h3><%= service.name %></h3>
        <p><%= service.description || 'Sem descrição.' %></p>
        <p><strong>Duração:</strong> <%= service.duration_minutes %> minutos</p>
        <p><strong>Preço:</strong> R$ <%= Number(service.price).toFixed(2).replace('.', ',') %></p>
        <a class="button small" href="/cliente/servico/<%= service.id %>">Ver horários livres</a>
      </div>
    <% }) %>
  </div>
</section>

<section class="card">
  <h2>Meus agendamentos</h2>

  <% if (appointments.length === 0) { %>
    <p>Você ainda não marcou nenhum horário.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Serviço</th>
            <th>Data e hora</th>
            <th>Status</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(a => { %>
            <tr>
              <td><%= a.service_name %></td>
              <td><%= formatDateTime(a.start_time) %></td>
              <td><span class="status <%= a.status %>"><%= a.status %></span></td>
              <td>
                <% if (a.status === 'pending' || a.status === 'confirmed') { %>
                  <form method="post" action="/cliente/agendamento/<%= a.id %>/cancelar" onsubmit="return confirm('Cancelar este agendamento?')">
                    <button class="danger small-button" type="submit">Cancelar</button>
                  </form>
                <% } else { %>
                  -
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
