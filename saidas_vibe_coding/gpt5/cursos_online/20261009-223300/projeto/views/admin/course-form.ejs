<%- include('../partials/header') %>

<div class="page-title">
  <div>
    <h1><%= mode === 'new' ? 'Novo curso' : 'Editar curso' %></h1>
    <p>Preencha as informações abaixo.</p>
  </div>
  <a class="button secondary" href="/admin/courses">Voltar</a>
</div>

<div class="form-card">
  <form method="post" action="<%= mode === 'new' ? '/admin/courses/new' : '/admin/courses/' + course.id + '/edit' %>" class="form">
    <label>
      Nome do curso
      <input type="text" name="title" value="<%= course.title || '' %>" required>
    </label>

    <label>
      Descrição
      <textarea name="description" rows="5" required><%= course.description || '' %></textarea>
    </label>

    <div class="form-row">
      <label>
        Carga horária
        <input type="text" name="workload" value="<%= course.workload || '' %>" required placeholder="Ex: 20 horas">
      </label>

      <label>
        Professor ou responsável
        <input type="text" name="teacher" value="<%= course.teacher || '' %>" required>
      </label>
    </div>

    <label class="checkbox">
      <input type="checkbox" name="active" value="1" <%= course.active ? 'checked' : '' %>>
      Curso publicado para alunos
    </label>

    <button class="button" type="submit">
      <%= mode === 'new' ? 'Cadastrar curso' : 'Salvar alterações' %>
    </button>
  </form>
</div>

<%- include('../partials/footer') %>
