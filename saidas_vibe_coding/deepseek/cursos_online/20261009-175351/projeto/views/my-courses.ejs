<%- include('layout-header') %>
<h1>Minhas Matrículas</h1>
<div class="grid">
  <% courses.forEach(c => { %>
    <div class="card">
      <h3><%= c.title %></h3>
      <p><%= c.description %></p>
      <div class="meta">👨‍🏫 <%= c.instructor %> • ⏱ <%= c.duration %></div>
      <div class="meta">Matriculado em: <%= new Date(c.created_at).toLocaleDateString('pt-BR') %></div>
      <form method="POST" action="/unenroll/<%= c.id %>">
        <button class="btn btn-danger" type="submit">Cancelar matrícula</button>
      </form>
    </div>
  <% }); %>
  <% if (courses.length === 0) { %>
    <p>Você ainda não está matriculado em nenhum curso. <a href="/">Ver cursos</a></p>
  <% } %>
</div>
<%- include('layout-footer') %>
